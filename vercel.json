{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build && node scripts/set-dashboard-target.mjs",
  "outputDirectory": "web/dist",
  "regions": ["iad1"],
  "functions": {
    "api/proxy.py": {
      "maxDuration": 30,
      "excludeFiles": "{web/**,tests/**,docs/**,legacy/**,fixtures/**,infra/**,scripts/**,modern/**,data/**,output/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/proxy?path=:path*" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "cache-control", "value": "no-store" },
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "no-referrer" },
        { "key": "x-frame-options", "value": "DENY" }
      ]
    }
  ]
}
