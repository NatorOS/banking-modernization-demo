{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Synthetic banking demo: modern payment integration (HTTP API + Lambda) on the existing foundation table. No VPC, NAT, or always-on compute.",
  "Parameters": {
    "TableName": {
      "Type": "String",
      "Description": "Foundation DynamoDB table name (non-secret)."
    },
    "ArtifactsBucket": {
      "Type": "String",
      "Description": "Foundation artifacts bucket holding the Lambda zip."
    },
    "CodeKey": {
      "Type": "String",
      "Description": "S3 key of the Lambda package."
    },
    "ThrottleRate": {
      "Type": "Number",
      "Default": 10
    },
    "ThrottleBurst": {
      "Type": "Number",
      "Default": 20
    }
  },
  "Resources": {
    "WebhookSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "HMAC key for the deterministic simulator's webhook signatures (synthetic demo only).",
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "hmac_key",
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "banking-modernization-demo"
          },
          {
            "Key": "DataClassification",
            "Value": "synthetic"
          }
        ]
      }
    },
    "FunctionLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "demo-table-and-logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DemoNamespacesOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:ConditionCheckItem",
                    "dynamodb:BatchWriteItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${TableName}"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "NS#demo-*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "WebhookKey",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "WebhookSecret"
                  }
                },
                {
                  "Sid": "Logs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${FunctionLogGroup.Arn}:*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "banking-modernization-demo"
          }
        ]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "FunctionLogGroup",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.13",
        "Handler": "modern.lambda_handler.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 15,
        "Role": {
          "Fn::GetAtt": [
            "FunctionRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactsBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "STORE_BACKEND": "dynamodb",
            "TABLE_NAME": {
              "Ref": "TableName"
            },
            "WEBHOOK_SECRET_ARN": {
              "Ref": "WebhookSecret"
            },
            "PAYMENT_PROVIDER": "simulator"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "banking-modernization-demo"
          },
          {
            "Key": "DataClassification",
            "Value": "synthetic"
          }
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http"
        },
        "ProtocolType": "HTTP",
        "DisableExecuteApiEndpoint": false,
        "Tags": {
          "Project": "banking-modernization-demo"
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "PayloadFormatVersion": "2.0",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "TimeoutInMillis": 15000
      }
    },
    "ApiRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api/{proxy+}",
        "AuthorizationType": "AWS_IAM",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingRateLimit": {
            "Ref": "ThrottleRate"
          },
          "ThrottlingBurstLimit": {
            "Ref": "ThrottleBurst"
          }
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "AccessLogGroup",
              "Arn"
            ]
          },
          "Format": "{\"requestId\":\"$context.requestId\",\"routeKey\":\"$context.routeKey\",\"status\":\"$context.status\",\"latencyMs\":\"$context.responseLatency\",\"caller\":\"$context.identity.caller\"}"
        }
      }
    },
    "AccessLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*/api/*"
        }
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "ApiFunction"
      }
    },
    "WebhookSecretArn": {
      "Value": {
        "Ref": "WebhookSecret"
      },
      "Description": "ARN only; the value is never output."
    },
    "Scope": {
      "Value": "Modern app stack. Deleting it leaves the foundation table and bucket in place."
    }
  }
}
